{
  "schema_version": "2.0.0",
  "说明": "节点概念不直接携带现金流项目或证据分数；完整父子路径规则形成方向候选，证据质量由固定程序计算。",
  "concepts": [
    {"concept": "operating_expense_parent", "terms": ["管理费用", "销售费用", "财务费用", "研发支出", "营业外支出"]},
    {"concept": "production_parent", "terms": ["生产成本", "制造费用", "劳务成本", "合同履约成本", "主营业务成本", "其他业务成本"]},
    {"concept": "inventory_acquisition_parent", "terms": ["材料采购", "在途物资", "原材料", "委托加工物资", "周转材料", "包装物", "低值易耗品"]},
    {"concept": "inventory_state_parent", "terms": ["库存商品", "发出商品", "在产品", "半成品", "产成品", "商品进销差价", "材料成本差异", "存货跌价准备"], "role": "neutral"},
    {"concept": "staff_cost", "terms": ["应付职工薪酬", "工资", "薪酬", "人工", "福利", "社保", "公积金", "绩效", "工会经费", "教育经费", "劳务派遣", "离职补偿"]},
    {"concept": "long_asset_parent", "terms": ["固定资产", "无形资产", "在建工程", "开发支出", "投资性房地产"]},
    {"concept": "long_asset_detail", "terms": ["设备", "电梯", "机器", "车辆", "运输工具", "房屋", "建筑", "工程", "生产线", "厂房", "软件", "专利", "土地使用权"]},
    {"concept": "engineering_payment", "terms": ["工程款", "设备款", "购置款", "建造款", "安装改造费", "搬迁改造费", "改造款", "安装费"]},
    {"concept": "repair", "terms": ["维修", "修理", "修缮", "维护", "保养"]},
    {"concept": "non_cash", "terms": ["折旧", "摊销", "结转", "计提", "减值", "转销", "领用", "出库", "入库", "完工", "成本分配", "费用分配", "制造费用分配", "分摊", "盘盈", "盘亏"]},
    {"concept": "purchase_inventory", "terms": ["材料款", "商品款", "采购款", "商品采购", "包装物采购", "外购商品", "货款", "物料", "辅材", "钢材", "产品材料", "直接材料", "材料费", "物料消耗"]},
    {"concept": "operating_expense_detail", "terms": ["办公", "差旅", "交通", "住宿", "物流", "快递", "审计", "咨询", "中介", "招待", "广告", "会务", "会议", "试验", "检测", "检验", "鉴定费", "计量", "认证", "燃料", "水费", "电费", "油费", "停车", "路桥", "安全生产", "环保", "手续费", "服务费", "培训费", "评审费", "专家费", "设计费", "招聘费", "订阅费", "电话费", "装订费", "装卸费", "售后服务", "招投标费", "董事会费"]},
    {"concept": "production_service_detail", "terms": ["外协加工费", "委外加工费", "外协加工", "委外加工", "委托加工", "加工费", "外包服务费", "外部劳务费", "外部履约服务费", "直接履约服务费", "外部试验费", "外部检测费", "外部检验费", "外部鉴定费"]},
    {"concept": "production_input_detail", "terms": ["生产用电费", "生产用水费", "生产用燃料", "生产检测费", "生产检验费", "燃料动力费", "燃动费"]},
    {"concept": "sales_business", "terms": ["主营业务收入", "销售收入", "应收货款", "应收账款", "预收账款", "合同负债"]},
    {"concept": "trade_payable", "terms": ["应付账款", "预付账款", "应付商品款"]},
    {"concept": "tax_parent", "terms": ["应交税费", "税金及附加"]},
    {"concept": "vat_tax", "terms": ["增值税", "进项税", "销项税", "待抵扣税"]},
    {"concept": "individual_tax", "terms": ["个人所得税", "个税"]},
    {"concept": "other_tax", "terms": ["企业所得税", "房产税", "土地使用税", "印花税", "车船税", "城建税", "城市维护建设税", "教育费附加", "地方教育附加", "环境保护税", "环保税"]},
    {"concept": "borrowing_principal", "terms": ["短期借款", "长期借款", "借款本金"]},
    {"concept": "interest_payment", "terms": ["应付利息", "利息支出", "借款利息"]},
    {"concept": "bank_interest_income", "terms": ["利息收入", "存款利息"]},
    {"concept": "investment_principal", "terms": ["长期股权投资", "交易性金融资产", "债权投资", "投资款"]},
    {"concept": "investment_income", "terms": ["投资收益", "股利收入", "分红收入"]},
    {"concept": "capital_principal", "terms": ["实收资本", "股本", "资本公积", "增资款"]},
    {"concept": "repurchase_obligation", "terms": ["限制性股票回购义务", "回购义务", "股份回购"]},
    {"concept": "penalty", "terms": ["罚款", "滞纳金", "违约金"]},
    {"concept": "employee_advance", "terms": ["备用金", "员工借支", "个人往来"]},
    {"concept": "deposit", "terms": ["保证金", "押金"]},
    {"concept": "other_receivable_payable", "terms": ["其他应收款", "其他应付款"]},
    {"concept": "asset_disposal_clearing", "terms": ["固定资产清理"]},
    {"concept": "accrual_marker", "terms": ["暂估", "暂记"]},
    {"concept": "settlement_marker", "terms": ["往来款", "结算款"]},
    {"concept": "operating_receivable_payable", "terms": ["日常往来", "经营往来"]},
    {"concept": "staff_detail", "terms": ["生产人员", "一线人员", "车间人员", "行政人员", "管理人员"]},
    {"concept": "expense_cost_layer", "terms": ["费用化支出", "直接费用", "间接费用", "直接投入", "间接成本", "研发成本", "硬件成本", "预防成本", "鉴定成本"], "role": "neutral"},
    {"concept": "note_parent", "terms": ["应收票据", "应付票据"]},
    {"concept": "note_type", "terms": ["银行承兑汇票", "商业承兑汇票"], "role": "neutral"},
    {"concept": "investment_object", "terms": ["有限公司", "有限责任公司", "股份有限公司", "合伙企业", "基金", "理财产品"], "role": "neutral"},
    {"concept": "account_qualifier", "terms": ["募集户", "募集资金账户", "一般户", "基本户"], "role": "neutral"}
  ],
  "inheritance_rules": [
    {"rule_id": "INHERIT-STAFF-DETAIL", "parent_concept": "staff_cost", "concept": "staff_detail", "terms": ["社会保险费", "养老保险", "医疗保险", "失业保险", "工伤保险", "生育保险", "养老", "医疗", "失业", "工伤", "生育", "大病医疗", "企业年金"]},
    {"rule_id": "INHERIT-PRODUCTION-INPUT-DETAIL", "parent_concept": "production_input_detail", "concept": "production_input_detail", "terms": ["水", "电", "燃气", "动力"]}
  ],
  "path_rules": [
    {"rule_id": "PATH-NONCASH", "require_any": ["non_cash"], "stop": true, "semantic": "非现金计提、折旧、摊销或结转"},
    {"rule_id": "PATH-ASSET-CLEARING", "require_any": ["asset_disposal_clearing"], "stop": true, "semantic": "长期资产处置清理，单凭路径不能判断收付项目"},
    {"rule_id": "PATH-NOTE-LONG-ASSET", "require_all": ["note_parent", "note_type", "long_asset_detail", "engineering_payment"], "inflow_candidate_item_ids": ["CFI-03"], "outflow_candidate_item_ids": ["CFI-06"], "semantic": "票据结算的基础业务为长期资产购建或处置"},
    {"rule_id": "PATH-NOTE-PURCHASE", "require_all": ["note_parent", "note_type"], "require_any": ["purchase_inventory", "inventory_acquisition_parent"], "inflow_candidate_item_ids": ["CFO-04"], "outflow_candidate_item_ids": ["CFO-04"], "semantic": "票据结算的基础业务为商品或材料采购"},
    {"rule_id": "PATH-NOTE-SETTLEMENT", "require_all": ["note_parent", "note_type"], "forbid": ["long_asset_detail", "engineering_payment", "purchase_inventory", "inventory_acquisition_parent", "investment_principal", "staff_cost"], "stop": true, "semantic": "票据结算类型已识别，但单凭票据类型不能判断现金流项目"},
    {"rule_id": "PATH-STAFF", "require_any": ["staff_cost"], "forbid": ["non_cash"], "min_levels": 2, "outflow_candidate_item_ids": ["CFO-05"], "semantic": "职工薪酬相关现金流出"},
    {"rule_id": "PATH-PRODUCTION-SERVICE", "level1_any": ["production_parent"], "require_any": ["production_service_detail"], "forbid": ["non_cash", "staff_cost"], "min_levels": 2, "outflow_candidate_item_ids": ["CFO-04"], "semantic": "完整成本路径显示为外购生产或履约服务"},
    {"rule_id": "PATH-PRODUCTION-INPUT", "level1_any": ["production_parent"], "require_any": ["production_input_detail"], "forbid": ["non_cash", "staff_cost"], "min_levels": 2, "outflow_candidate_item_ids": ["CFO-04"], "semantic": "完整成本路径显示为外购生产投入"},
    {"rule_id": "PATH-OPERATING-EXPENSE", "level1_any": ["operating_expense_parent"], "forbid": ["non_cash", "staff_cost", "interest_payment", "bank_interest_income", "investment_principal", "investment_income", "production_service_detail"], "min_levels": 2, "inflow_candidate_item_ids": ["CFO-03"], "outflow_candidate_item_ids": ["CFO-07"], "semantic": "日常经营费用往来"},
    {"rule_id": "PATH-PRODUCTION-INVENTORY", "level1_any": ["production_parent"], "require_any": ["purchase_inventory"], "forbid": ["non_cash", "staff_cost"], "min_levels": 2, "outflow_candidate_item_ids": ["CFO-04"], "semantic": "生产所需商品或材料采购"},
    {"rule_id": "PATH-LONG-ASSET", "level1_any": ["long_asset_parent"], "forbid": ["non_cash", "repair"], "inflow_candidate_item_ids": ["CFI-03"], "outflow_candidate_item_ids": ["CFI-06"], "semantic": "长期资产购建或处置"},
    {"rule_id": "PATH-LONG-ASSET-PAYABLE", "require_all": ["long_asset_detail", "engineering_payment"], "forbid": ["operating_expense_parent", "production_parent", "non_cash", "repair"], "min_levels": 2, "inflow_candidate_item_ids": ["CFI-03"], "outflow_candidate_item_ids": ["CFI-06"], "semantic": "完整往来路径显示为长期资产购建或处置"},
    {"rule_id": "PATH-INVENTORY-ACQUISITION", "level1_any": ["inventory_acquisition_parent"], "forbid": ["non_cash", "staff_cost", "long_asset_detail"], "min_levels": 2, "outflow_candidate_item_ids": ["CFO-04"], "semantic": "直接存货入口科目已显示为外购材料、商品或加工服务，无需重复出现采购字样"},
    {"rule_id": "PATH-INVENTORY-STATE-PURCHASE", "level1_any": ["inventory_state_parent"], "require_any": ["purchase_inventory"], "forbid": ["non_cash", "staff_cost", "long_asset_detail"], "min_levels": 2, "outflow_candidate_item_ids": ["CFO-04"], "semantic": "存货状态科目下的明细显示为外购商品或材料"},
    {"rule_id": "PATH-SALES", "level1_any": ["sales_business"], "forbid": ["non_cash"], "inflow_candidate_item_ids": ["CFO-01"], "outflow_candidate_item_ids": ["CFO-01"], "semantic": "销售商品或提供劳务相关收款、退款"},
    {"rule_id": "PATH-TRADE-PURCHASE", "level1_any": ["trade_payable"], "require_any": ["purchase_inventory", "inventory_acquisition_parent", "production_service_detail"], "forbid": ["non_cash", "long_asset_detail", "engineering_payment"], "min_levels": 2, "inflow_candidate_item_ids": ["CFO-04"], "outflow_candidate_item_ids": ["CFO-04"], "semantic": "购买商品或接受劳务相关付款、退款"},
    {"rule_id": "PATH-TAX", "level1_any": ["tax_parent"], "require_any": ["other_tax"], "forbid": ["vat_tax", "individual_tax", "non_cash"], "min_levels": 2, "inflow_candidate_item_ids": ["CFO-02"], "outflow_candidate_item_ids": ["CFO-06"], "semantic": "可独立判断税种的税费收付"},
    {"rule_id": "PATH-BORROWING", "require_any": ["borrowing_principal"], "forbid": ["non_cash", "interest_payment"], "inflow_candidate_item_ids": ["CFF-02"], "outflow_candidate_item_ids": ["CFF-04"], "semantic": "借款本金取得或偿还"},
    {"rule_id": "PATH-INTEREST-PAYMENT", "require_any": ["interest_payment"], "forbid": ["non_cash"], "outflow_candidate_item_ids": ["CFF-05"], "semantic": "偿付借款利息"},
    {"rule_id": "PATH-BANK-INTEREST", "require_any": ["bank_interest_income"], "forbid": ["interest_payment", "non_cash"], "inflow_candidate_item_ids": ["CFO-03"], "semantic": "银行存款利息收入"},
    {"rule_id": "PATH-INVESTMENT-PRINCIPAL", "require_any": ["investment_principal"], "forbid": ["non_cash"], "inflow_candidate_item_ids": ["CFI-01"], "outflow_candidate_item_ids": ["CFI-07"], "semantic": "投资本金收回或支付"},
    {"rule_id": "PATH-INVESTMENT-INCOME", "require_any": ["investment_income"], "forbid": ["non_cash"], "inflow_candidate_item_ids": ["CFI-02"], "semantic": "取得投资收益"},
    {"rule_id": "PATH-CAPITAL", "require_any": ["capital_principal"], "forbid": ["non_cash"], "inflow_candidate_item_ids": ["CFF-01"], "outflow_candidate_item_ids": ["CFF-06"], "semantic": "权益资本投入或退回"},
    {"rule_id": "PATH-REPURCHASE", "require_any": ["repurchase_obligation"], "forbid": ["non_cash"], "outflow_candidate_item_ids": ["CFF-06"], "semantic": "股份回购相关现金流出"},
    {"rule_id": "PATH-PENALTY", "require_any": ["penalty"], "forbid": ["non_cash"], "inflow_candidate_item_ids": ["CFO-03"], "outflow_candidate_item_ids": ["CFO-07"], "semantic": "经营罚款、滞纳金或违约金"},
    {"rule_id": "PATH-EMPLOYEE-ADVANCE", "require_any": ["employee_advance"], "forbid": ["non_cash"], "inflow_candidate_item_ids": ["CFO-03"], "outflow_candidate_item_ids": ["CFO-07"], "semantic": "员工备用金或借支往来"},
    {"rule_id": "PATH-OPERATING-RECEIVABLE-PAYABLE", "require_all": ["other_receivable_payable", "operating_receivable_payable"], "forbid": ["non_cash"], "min_levels": 2, "inflow_candidate_item_ids": ["CFO-03"], "outflow_candidate_item_ids": ["CFO-07"], "semantic": "明确为日常经营的其他往来"},
    {"rule_id": "PATH-DEPOSIT", "require_any": ["deposit"], "forbid": ["non_cash"], "inflow_candidate_item_ids": ["CFO-03"], "outflow_candidate_item_ids": ["CFO-07"], "semantic": "未显示长期资产或筹资属性的保证金、押金往来"}
  ]
}
