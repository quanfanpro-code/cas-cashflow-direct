{
  "schema_version": "1.0",
  "rule_metadata": [
    {
      "rule_id": "SPECIAL-CASH-SCOPE",
      "name": "现金范围识别与排除",
      "category": "现金范围",
      "priority": 10,
      "reason": "现金范围逐账户确认，公司专属决定只在本次运行生效",
      "status": "active",
      "version": "1"
    },
    {
      "rule_id": "SPECIAL-COMPONENT-PAYROLL",
      "name": "真实付款与同凭证非现金计提拆分",
      "category": "业务组成",
      "priority": 10,
      "reason": "业务关系限定完整分配方案，逐来源守恒且唯一才能采用；扣项和独立非现金事项分别留痕",
      "status": "active",
      "version": "2"
    },
    {
      "rule_id": "SPECIAL-VAT-COMPANION",
      "name": "增值税附属项目",
      "category": "特殊业务",
      "priority": 10,
      "reason": "满足同凭证同方向和唯一基础交易时随基础项目",
      "status": "active",
      "version": "1"
    },
    {
      "rule_id": "SPECIAL-DOCUMENTED-REVERSAL",
      "name": "明确引用原凭证的等额现金冲销",
      "category": "特殊业务",
      "priority": 20,
      "reason": "只有原凭证日期、号码、记账字、同一现金账户、原现金摘要及反向金额全部唯一吻合，才沿用原项目相抵；达到整体重要性仍逐笔确认",
      "status": "active",
      "version": "1"
    },
    {
      "rule_id": "SPECIAL-CONTROLLED-EXCLUSION",
      "name": "真实现金受控排除",
      "category": "排除控制",
      "priority": 10,
      "reason": "自由文字不能删除真实现金金额",
      "status": "active",
      "version": "1"
    },
    {
      "rule_id": "RECON-PENDING-CASH-BRIDGE",
      "name": "未决现金桥接",
      "category": "勾稽",
      "priority": 10,
      "reason": "未决现金参与现金变动桥接但不进入具体正表项目",
      "status": "active",
      "version": "1"
    },
    {
      "rule_id": "RECON-FINAL-SUCCESS",
      "name": "最终勾稽成功",
      "category": "勾稽",
      "priority": 20,
      "reason": "未决为零、必做人工完成且最终差异为零",
      "status": "active",
      "version": "1"
    }
  ],
